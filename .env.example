# ============================================================
# DDP Noticias - Variables de entorno
# ============================================================
# Copia este archivo como ".env" para desarrollo local.
# En RAILWAY NO copies este archivo: configura las variables
# directamente en el panel del servicio (Variables).
#
# El archivo .env esta en .gitignore y NUNCA debe subirse al repositorio.
# ============================================================


# --- Entorno de ejecucion -----------------------------------
# local      -> muestra errores en pantalla, recuperacion de contrasena
#               muestra el enlace en pantalla (sin SMTP).
# production -> oculta errores, usa HTTPS en cookies.
# Valores admitidos: local | staging | production
APP_ENV=local


# --- Prefijo URL de la instalacion -------------------------
# Dejalo VACIO cuando la app vive en la raiz del dominio (Railway).
# En XAMPP dentro de htdocs debe ser /revista-ddp
#
# Si lo dejas vacio se detecta automaticamente desde SCRIPT_NAME.
# Forcedalo solo si el proxy no expone public/ en SCRIPT_NAME.
APP_BASE_URL=

# public/ y uploads/ se sirven como arboles fisicos.
# Solo cambia esto si mueves el document root.
APP_PUBLIC_URL=
APP_UPLOADS_URL=


# --- Base de datos -----------------------------------------
# Opcion A (recomendada en Railway): pega aqui la variable
# DATABASE_URL que genera el propio Railway al crear el MySQL.
# Formato: mysql://USUARIO:CLAVE@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=

# Opcion B: variables sueltas (util para XAMPP/MariaDB local).
# Se ignoran si DATABASE_URL esta definida.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=revista_digital
DB_USER=root
DB_PASS=


# --- Correo (opcional) -------------------------------------
# El proyecto NO tiene SMTP configurado. Sin estas variables el
# formulario de contacto escribe en storage/logs/contactos.txt y la
# recuperacion de contrasena muestra el enlace en pantalla.
# Implementa el envio antes de relying on esto en produccion.
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@dialogoydesarrollo.com.pe
MAIL_FROM_NAME="DDP Noticias"
